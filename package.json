{
  "name": "inat-components",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build -w @imerss/inat-components && npm run build -w @imerss/inat-components-utils",
    "clean": "npm run clean --workspaces --if-present",
    "generate": "npm run generate -w demo",
    "watchPackages": "npm-run-all --parallel watchComponents watchUtils",
    "watchComponents": "npm run watch -w @imerss/inat-components",
    "watchUtils": "npm run watch -w @imerss/inat-components-utils",
    "dev": "npm run watchPackages",
    "standalone": "npm run watch -w @imerss/inat-components-standalone",
    "watchDemo": "npm run watch -w demo",
    "demo": "npm-run-all --parallel watchPackages watchDemo"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {},
  "workspaces": [
    "packages/inat-components-shared",
    "packages/inat-components",
    "packages/inat-components-utils",
    "packages/inat-components-standalone",
    "apps/demo"
  ]
}
